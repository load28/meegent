#!/usr/bin/env bash
set -euo pipefail
# Run the meeagent pi agent on THIS repo (dev). For other projects, see README
# "다른 프로젝트에서 개발 모드로 실행" — point that project's .pi/settings.json at this repo's extension.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$DIR"
# Load the OpenRouter API key (gitignored).
[ -f .env.local ] && set -a && . ./.env.local && set +a
# Run the pinned pi (0.73.1).
exec ./node_modules/.bin/pi "$@"
